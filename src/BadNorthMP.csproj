<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>BadNorthMP</AssemblyName>
    <RootNamespace>BadNorthMP</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The game runs the legacy .NET 3.5 Mono runtime, but Managed\UnityEngine.dll is a facade that references
         mscorlib 4.0. Don't let MSBuild chase reference dependencies into it (it would reject every reference). -->
    <_FindDependencies>false</_FindDependencies>
    <!-- Compile against the game's own (stripped) mscorlib/System/System.Core instead of the full .NET 3.5
         reference assemblies, so APIs the game doesn't ship are build errors instead of in-game TypeLoadExceptions. -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>

    <!-- Override on the command line if the game lives elsewhere: dotnet build -p:GameDir="D:\...\BadNorth" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BadNorth</GameDir>
    <ManagedDir>$(GameDir)\BadNorth_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginDeployDir>$(BepInExDir)\plugins\BadNorthMP</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib" HintPath="$(ManagedDir)\mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(ManagedDir)\System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(ManagedDir)\System.Core.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Fabric.Core" HintPath="$(ManagedDir)\Fabric.Core.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestWWWModule" HintPath="$(ManagedDir)\UnityEngine.UnityWebRequestWWWModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" HintPath="$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UpdateInstall.ps1" LogicalName="BadNorthMP.UpdateInstall.ps1" />
    <!-- Viking commander flags (GMW's Viking Commander) and the sail-in war cries (GMW's Commanders Sail In). -->
    <EmbeddedResource Include="..\assets\VikingCommanders\*.png" LogicalName="BadNorthMP.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\assets\SailIn\*.ogg" LogicalName="BadNorthMP.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PluginDeployDir)" />
  </Target>

</Project>
